      "parameters": {
        "jsCode": "// This node expects raw string output from the previous Execute Command node\n// The output is a JSON array of tweets\ntry {\n  const rawJsonString = $node[\"ScrapeTweetsTwikit\"].stdout;\n  const tweets = JSON.parse(rawJsonString);\n  return tweets.map(tweet => ({ json: tweet }));\n} catch (err) {\n  return [{ json: { error: err.message } }];\n}"
      },
