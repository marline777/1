      "parameters": {
        "jsCode": "const tweets = $node['ExcludeProcessed'].json;\nconst scoredTweets = tweets.map(tweet => ({\n  ...tweet,\n  engagementScore: tweet.reply_count + tweet.likes + tweet.retweets\n}));\nscoredTweets.sort((a, b) => b.engagementScore - a.engagementScore);\nreturn scoredTweets.map(tweet => ({ json: tweet }));"
