    {
      "parameters": {
        "jsCode": "// This node expects raw string output from the previous Execute Command node\n// The output is a JSON array of tweets\ntry {\n  const rawJsonString = $node[\"ScrapeTweetsTwikit\"].stdout;\n  const parsedJson = JSON.parse(rawJsonString);\n\n  // Return an array of items, where each item is a tweet object\n  // n8n expects an array of objects for its next nodes\n  return parsedJson.map(tweet => ({ json: tweet }));\n\n} catch (error) {\n  // Log the error and the problematic raw string for debugging\n  console.error(\"Error parsing JSON from ScrapeTweetsTwikit:\", error.message);\n  console.error(\"Raw string received:\", $node[\"ScrapeTweetsTwikit\"].stdout);\n  throw new Error(\"Failed to parse JSON output from twikit scraper.\");\n}"
      },
