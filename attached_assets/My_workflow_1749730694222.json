    {
      "parameters": {
        "jsCode": "const tweets = $node['ExcludeProcessed'].json;\nconst scoredTweets = tweets.map(tweet => ({\n  ...tweet,\n  engagementScore: tweet.reply_count + tweet.likes + tweet.retweets\n}));\nconst sortedTweets = scoredTweets.sort((a, b) => b.engagementScore - a.engagementScore);\nconst highEngagement = sortedTweets.filter(t => t.reply_count > 50 || t.likes + t.retweets > 100).slice(0, 2);\nconst moderateEngagement = sortedTweets.filter(t => t.reply_count >= 5 && t.reply_count <= 50 && t.likes + t.retweets >= 10 && t.likes + t.retweets <= 100).slice(0, 3);\nreturn [...highEngagement, ...moderateEngagement].slice(0, 5);"
      },
